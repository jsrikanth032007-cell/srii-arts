{
  "name": "srii-arts",
  "version": "1.0.0",
  "description": "SRII ARTS - AI-Native Desktop NLE Studio Director for CapCut Desktop",
  "scripts": {
    "build": "echo 'Root build complete'",
    "start": "python -m uvicorn backend.main:app --host 0.0.0.0 --port $PORT",
    "dev:backend": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build"
  }
}
